/*其他按钮样式*/
QPushButton{
    color:#333333;
    border: 1px solid #8c8c8c;
    border-radius: 5px;        /* 圆角（可选） */
    padding: 5px;              /* 按钮内边距 */
    /* background-color: #b2d4f5, */
    background-color: rgb(255,255,255,100);
}
QPushButton:hover{
    color:#333333;
    border: 1px solid #8c8c8c; /* 按钮边框颜色 */
    border-radius: 5px;        /* 圆角（可选） */
    padding: 5px;              /* 按钮内边距 */
    background-color: qlineargradient(
        spread: pad,
        x1: 0, y1: 0, x2: 0, y2: 1,
		stop: 0 #b2d4f5,
		/* stop: 0.5 #bbd4f3,  */
		stop: 1 #d7e0fd
    );
}

