QTableCornerButton::section {
	/* background-color: #d6dcf6; */
	/* background-color: rgb(192,220,245);  */
	background-color: qlineargradient(
        spread: pad,
        x1: 0, y1: 0, x2: 0, y2: 1,
        /* stop: 0 #f8f8f8, /* 顶部高光 */
        /* stop: 0.5 #d6dcf6, 中间颜色 */
        /* stop: 1 #8c8c8c 底部阴影  */
		/* stop: 0 #90CEF5,
		stop: 0.5 #bbd4f3, 
		stop: 1 #d7e0fd */
		stop: 0 #b2d4f5,
		stop: 0.5 #bbd4f3, 
		stop: 1 #d7e0fd
    );
    border: 1px solid darkgray;  
}

QHeaderView::section {
    background-color: qlineargradient(
        spread: pad,
        x1: 0, y1: 0, x2: 0, y2: 1,
        /* stop: 0 #f8f8f8, /* 顶部高光 */
        /* stop: 0.5 #d6dcf6, 中间颜色 */
        /* stop: 1 #8c8c8c 底部阴影  */
		/* stop: 0 #90CEF5,
		stop: 0.5 #bbd4f3, 
		stop: 1 #d7e0fd */
		stop: 0 #b2d4f5,
		stop: 0.5 #bbd4f3, 
		stop: 1 #d7e0fd
    );
    border: 1px solid #8c8c8c;
    border-top: 2px solid #ffffff; /* 顶部高光 */
    border-left: 2px solid #ffffff; /* 左侧高光 */
    border-bottom: 2px solid #666666; /* 底部阴影 */
    border-right: 2px solid #666666; /* 右侧阴影 */
    padding: 4px;
    font-family: "SimHei";
    font-size: 12px;
    font-weight: bold;
    text-align: center;
}

