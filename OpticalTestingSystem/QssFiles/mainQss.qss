
QMainWindow {
    background: qlineargradient(
        spread: pad,
        x1: 0, y1: 0,
        x2: 1, y2: 1,
		stop: 0 #90CEF5,
		stop: 1 #FCEAFF	
    ); /*注意：使用这种方式修饰背景时，四个边角是无法修剪的，一直是直角*/
    /* background:white; */
	border-radius:4px; /*给ui界面的四个边角添加一个弧度，更圆润*/
    /* border:1px solid lightgray; 可选：添加边框 */
    border: 1px solid transparent;
    /* border-top-right-radius:10px */
    /* border-radius: 6px;       可选：设置圆角边框 */
}

/* 设置菜单栏的背景和渐变效果 */
QMainWindow::menubar {
	background-color: transparent;
    color:white;  
}


/* 让菜单项和子菜单的背景也支持渐变 */
