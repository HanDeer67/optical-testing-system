QLabel {
    /* color: darkgray; */
    font-size: 13px;
}
/* 设置方框背景颜色，确保勾选时的对钩图标显示*/
QCheckBox{
	font-size: 13px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid rgb(126, 120, 120);
    border-radius: 2px; /* 可选，调整圆角 */
}

QCheckBox::indicator:checked {
    /* background-color: #3c8dbc; 选中时背景颜色 */
	width: 14px;
    height: 14px;
    /* border: none; 选中时的边框颜色 */
	border: 1px solid rgb(126, 120, 120);
	background-repeat: no-repeat;
    background-position: center;
	background-size: contain;
	/* background-image: url("H:/航星代码备份/1. 上位机/2. 红外-崔启胤-光学测试系统/OpticalTestingSystem/Icon_images/checked.png");  */
	/* background-image: url("C:/Users/P14S/Downloads/checked_resized.png"); */
	background-image: url(":/Icon/Icon_images/checked_resized.png");
	/*这行代码最好放在mainwindow.cpp中
	直接设置，那边可以使用src的文件*/
}


QTabBar::tab
{ 
	/* background:white; */
	
	border-bottom: 0px solid rgba(255, 242, 251,100);
	font-family:"微软雅黑";
	font-size:16px;
	padding-left:5px;
	padding-right:5px;
	min-width: 85px;
	min-height:30px;		
}

QTabBar::tab:selected
{
	border-bottom: 3px solid rgb(236,65,65);
	color: rgb(55,55,55);
	font-size:20px;
	font-weight: bold;
}

QDockWidget::title{
	background-color: lightblue; /* 天蓝色背景 */
        height: 100px;               /* 标题栏高度 */
        font: bold 14px;            /* 加粗字体 */
		/* font-size:20px; */
        color: black;               /* 字体颜色 */
        padding-left: 10px;         /* 左侧内边距 */
}

QDockWidget::close-button, QDockWidget::float-button {
	border: 1px solid lightblue; /* 去掉边框 */
	background: white;           /* 按钮背景 */
	padding: 2px;
	border-radius: 5px;
}

/*设置groupbox的标题颜色*/
QGroupBox::title {
    color: rgb(5,127,238);
}
/*设置MainWindow的背景颜色*/
/* QMainWindow {
    background-color: #90CEF5; /* 针对 QMainWindow 设置
} */

QTableWidget {

    font-family: "Times New Roman", "宋体";  /* 英文用新罗马，中文用宋体 */
	font-size: 14px;
	color:#333333;
	/* background-color: lightblue;  */
	/* background-color: transparent; */
    gridline-color: darkgray; /* 设置网格线颜色 */
    border: none; /* 去除表格的边框 */
}

/* QTableView {
    background-color: transparent;
} */
/*边框的样式设置*/
QHeaderView::section {
    /* background-color: transparent;  背景颜色 */
	background-color:rgb(192,220,245);
    color: #333333;            /* 字体颜色 */
	font-family: "SimHei"; 
	font-size: 15px;
    /* font-weight: bold;         字体加粗 */
    border: 1px solid #d0d0d0; /* 边框颜色 */
    padding: 4px;              /* 内边距 */
    text-align: center;        /* 文本居中 */
}
/*边框内部的表格线条样式*/
QTableView QHeaderView::section {
    /* background-color: transparent; 水平和垂直表头的背景颜色 */
    border: 1px solid darkgray; /* 边框样式 */
}
QTableWidget::item:selected {
    background-color: rgba(255,255,255,50); /* 选中单元格背景颜色 */
}
